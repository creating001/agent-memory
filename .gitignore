# Python cache / test artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/

# Local environment / secrets
.env
.env.*
!.env.example
.venv/
venv/

# Local agent/tool state
.agents/
.codex/

# Benchmark data should be supplied locally.
data/**
!data/
!data/.gitkeep

# Generated experiment artifacts.
outputs/**
!outputs/
!outputs/.gitkeep

# Runtime files
*.log
*.pid

# Editor / OS files
.DS_Store
.idea/
.vscode/
